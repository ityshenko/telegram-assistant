services:
  - type: web
    name: telegram-assistant
    env: python
    buildCommand: pip install -r requirements.txt
    startCommand: python3 bot.py
    envVars:
      - key: TELEGRAM_BOT_TOKEN
        sync: false
      - key: YOUR_CHAT_ID
        sync: false
      - key: DIGEST_TIME
        value: "20:00"
      - key: DATA_DIR
        value: "/app/data"
	services:
  - type: web
    name: telegram-assistant
    env: python
    buildCommand: |
      pip install -r requirements.txt
      bash download_model.sh
    startCommand: python3 bot.py
    disk:
      name: bot-data
      mountPath: /app/data
      sizeGB: 1
    envVars:
      - key: TELEGRAM_BOT_TOKEN
        sync: false
      - key: YOUR_CHAT_ID
        sync: false
      - key: DIGEST_TIME
        value: "20:00"
      - key: DATA_DIR
        value: "/app/data"services:
